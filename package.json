{
  "name": "agent-control",
  "version": "3.9.0",
  "private": true,
  "type": "module",
  "description": "Infrastructure-neutral policy control plane and adaptive agent harness",
  "bin": {
    "agent-control": "scripts/agent-control.mjs"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "web": "tsx src/web.ts",
    "acp": "node --import tsx src/acp.ts",
    "acp:remote": "node --import tsx src/acp-remote.ts",
    "dev": "tsx watch src/index.ts",
    "init": "node scripts/init-config.mjs",
    "init:teammates": "node --import tsx scripts/init-teammates.ts",
    "test": "node --import tsx --test --test-concurrency=1 src/*.test.ts src/control/*.test.ts src/ui/*.test.ts scripts/*.test.mjs android/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:bootstrap": "node --check scripts/agent-control.mjs scripts/status-client.mjs scripts/control-plane.mjs scripts/config.mjs scripts/qualify-all.mjs scripts/record-provider-neutral-qualification.mjs scripts/record-windows-cleanup-qualification.mjs scripts/record-recovery-qualification.mjs scripts/record-android-adb-qualification.mjs android/adb-local.mjs android/node-server.mjs && bash -n android/resource-agent.sh android/start-node.sh android/install-boot.sh android/termux-boot-agent-control.sh scripts/qualify-remote.sh scripts/managed-node-probe.sh scripts/managed-node-action.sh",
    "test:android-adb": "node --test android/adb-local.test.mjs",
    "check:neutrality": "node --test scripts/infrastructure-neutrality.test.mjs",
    "check:dashboard": "node --check assets/dashboard/dashboard.js assets/dashboard/dashboard-parameters.js assets/dashboard/dashboard-running-state.js assets/dashboard/dashboard-enhancements.js assets/dashboard/dashboard-parameterized-jobs.js assets/dashboard/dashboard-models.js assets/dashboard/dashboard-sessions.js",
    "check:status": "node scripts/implementation-status.mjs --check",
    "status:implementation": "node scripts/implementation-status.mjs",
    "check": "npm run typecheck && npm run check:bootstrap && npm run check:dashboard && npm run check:neutrality && npm run check:status && npm test",
    "qualify": "node scripts/qualify-all.mjs",
    "qualify:all": "npm run qualify",
    "up": "node scripts/control-plane.mjs up",
    "status": "node scripts/agent-control.mjs status",
    "status:bootstrap": "node scripts/control-plane.mjs status",
    "down": "node scripts/control-plane.mjs down",
    "provision:android": "node --import tsx scripts/provision-android.mjs",
    "demo:context": "node --import tsx scripts/demo-context-consensus.mjs",
    "demo:teammates": "node --import tsx scripts/demo-persistent-teammates.ts",
    "qualify:jobs": "node --import tsx scripts/qualify-jobs.ts",
    "qualify:managed-node": "node --import tsx scripts/qualify-managed-node.ts",
    "qualify:harness-real": "node --import tsx scripts/qualify-real-harness-job.ts",
    "qualify:provider-cache": "node --import tsx scripts/qualify-provider-cache-boundary.ts",
    "qualify:openai-chatkit": "node --env-file=.env.local --import tsx scripts/qualify-openai-chatkit.mjs",
    "qualify:openai-windows": "node --env-file-if-exists=.env.local --import tsx scripts/qualify-openai-windows-harness.ts",
    "qualify:provider-neutral": "node --import tsx scripts/qualify-provider-neutral-3.9.ts",
    "record:provider-neutral": "node scripts/record-provider-neutral-qualification.mjs",
    "qualify:windows-cleanup": "node --import tsx scripts/qualify-windows-cleanup.ts",
    "record:windows-cleanup": "node scripts/record-windows-cleanup-qualification.mjs",
    "qualify:recovery": "node --import tsx scripts/qualify-recovery-3.9.ts",
    "record:recovery": "node scripts/record-recovery-qualification.mjs",
    "qualify:android-adb": "node --import tsx scripts/qualify-android-adb-3.9.ts",
    "record:android-adb": "node scripts/record-android-adb-qualification.mjs",
    "benchmark:token-output": "node --import tsx scripts/benchmark-token-aware-output.ts",
    "benchmark:harness-efficiency": "node --import tsx scripts/benchmark-harness-efficiency.ts",
    "benchmark:harness-efficiency:live": "node --import tsx scripts/benchmark-harness-efficiency-live.ts",
    "benchmark:harness-mutation:live": "node --import tsx scripts/benchmark-harness-mutation-live.ts",
    "benchmark:context-compiler": "node --import tsx scripts/benchmark-context-compiler.ts",
    "benchmark:fast-execution": "node --import tsx scripts/benchmark-fast-execution.ts",
    "benchmark:capability-routing": "node --import tsx scripts/benchmark-capability-routing.ts",
    "qualify:edge-context-runtime": "node --import tsx scripts/qualify-edge-context-runtime.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "ajv": "^8.17.1",
    "blessed": "^0.1.81",
    "playwright-core": "^1.62.1",
    "ws": "8.21.3",
    "yaml": "^2.8.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
